{
  "name": "navride-fleet-firebase",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-navride-fleet --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:dashboard": "node --test tests/route-utils.test.mjs tests/theme.test.mjs tests/login-ui.test.mjs tests/marker-utils.test.mjs",
    "test:browser": "node --test tests/dashboard.browser.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "axe-core": "^4.14.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.33.0",
    "playwright": "^1.64.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "basic-ftp": "6.2.3",
    "@google-cloud/pubsub": { "@opentelemetry/core": "2.12.0" },
    "gaxios": { "uuid": "11.1.1" }
  }
}
